# HPDC dev-cluster sizing & topology
# Copy to .env and adjust; bootstrap_talos_dev.py reads these at startup.
# All values are passed straight to `talosctl cluster create qemu`.
#
# Component versions below are resolved by scripts/gitops/component_versions.py
# and consumed by every installer, validator, image-preflight and the GitOps
# renderer. Changing a version requires the images to exist in the local
# registry mirror (localhost:5000) BEFORE bootstrap — preflight --check gates
# this and prints exact fill commands when something is missing.
# After changing: render_overlays.py -> commit rendered/ -> rerun step 09 ->
# hard-refresh ArgoCD apps.

# Provisioner backend: kind (default) | docker | qemu
#   kind   = kind + local-path (fast business-logic dev, default)
#   docker = Talos-on-Docker + local-path (portable dev)
#   qemu   = Talos/QEMU + rook-ceph (localhost production-evaluation)
HPDC_PROVIDER=kind

# Node counts / sizing
HPDC_CONTROLPLANES=1
HPDC_WORKERS=3
HPDC_CPUS_CONTROLPLANE=2.0
HPDC_MEMORY_CONTROLPLANE=6144
HPDC_CPUS_WORKER=1.0
HPDC_MEMORY_WORKER=4096

# Per-node disk capacities (k8s quantity units — use Gi, not GiB)
# kind/docker: used as local-path defaultVolumeSize
# qemu: synthesize virtio data disks (explicit HPDC_DISKS wins for qemu if set)
HPDC_DISK_CAPACITY_WORKER=10Gi
HPDC_DISK_CAPACITY_CONTROL_PLANE=10Gi

# Cluster network + persistent disks
# Disks: first entry = OS disk on ALL nodes, later entries = worker-only data disks
HPDC_SUBNET=10.6.0.0/24
HPDC_DISKS=virtio:10GiB,virtio:10GiB

# Kubernetes version — MUST match images cached in the local registry mirror
HPDC_KUBERNETES_VERSION=1.35.2

# CNI / mesh (Cilium is helm-installed; envoy tag is pinned per cilium release)
HPDC_CILIUM_VERSION=1.20.1
HPDC_CILIUM_ENVOY_TAG=v1.37.5-1786810558-766ccfb37260a43e9d228837aa84ce3faf9f64e7
HPDC_HUBBLE_UI_VERSION=v0.13.5
HPDC_SPIRE_VERSION=1.15.3

# Storage
HPDC_ROOK_CEPH_VERSION=1.20.6
HPDC_LOCAL_PATH_PROVISIONER_VERSION=v0.0.37

# Registry / offline cache
HPDC_HARBOR_VERSION=2.15.2
HPDC_HARBOR_CHART_VERSION=1.19.2
HPDC_HARBOR_REDIS_VERSION=7.4-alpine
HPDC_HARBOR_POSTGRES_VERSION=15.19-alpine
HPDC_SPEGEL_VERSION=0.7.4

# GitOps / CD stack
HPDC_ARGOCD_VERSION=3.5.1
HPDC_ARGOCD_REDIS_VERSION=8.2.8-alpine
HPDC_KARGO_VERSION=1.11.2
HPDC_KARGO_CHART_VERSION=1.11.2
HPDC_CERT_MANAGER_CHART_VERSION=v1.21.1
HPDC_CERT_MANAGER_VERSION=1.21.1
HPDC_ARGO_ROLLOUTS_VERSION=1.9.1
HPDC_ROLLOUTS_NGINX_VERSION=1.27-alpine
HPDC_ARGO_EVENTS_VERSION=1.9.11
HPDC_EVENTS_ALPINE_VERSION=3.20

# Edge gateway
HPDC_ENVOY_GATEWAY_VERSION=1.9.0

# Auth / secrets
HPDC_CASDOOR_VERSION=3.159.0
HPDC_INFISICAL_VERSION=v0.162.24

# Observability
HPDC_GRAFANA_VERSION=13.2.0
HPDC_VICTORIA_METRICS_VERSION=1.150.0
HPDC_VICTORIA_LOGS_VERSION=v1.52.0
HPDC_OTEL_COLLECTOR_VERSION=0.159.0
HPDC_ALERTMANAGER_VERSION=v0.34.0

# Developer portal / API docs
HPDC_BACKSTAGE_VERSION=1.54.0
HPDC_SWAGGER_UI_VERSION=v5.32.14

# Utilities
HPDC_GIT_MIRROR_IMAGE_VERSION=2.54.0
HPDC_KUBECTL_VERSION=1.35.2
