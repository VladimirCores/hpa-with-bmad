# HPDC provisioning & sizing
# Copy to .env and adjust; startup.dev.py reads these at startup.
#
# Three config layers (loaded in order):
#   .env              — provisioning & sizing (this file)
#   .env.components   — component toggles & storage backend
#   .env.versions     — version pins
#
# Existing environment variables always win over file values (setdefault).
# See .env.components.example and .env.versions.example for the other layers.

# Provisioner backend: kind (default) | docker | qemu
#   kind   = kind + local-path (fast business-logic dev, default)
#   docker = Talos-on-Docker + local-path (portable dev)
#   qemu   = Talos/QEMU + local-path (rook-ceph is staging-only; set HPDC_STAGING_ENABLED=true)
HPDC_PROVIDER=kind

# Node counts / sizing
HPDC_CONTROLPLANES=1
HPDC_WORKERS=3
HPDC_CPUS_CONTROLPLANE=2.0
HPDC_MEMORY_CONTROLPLANE=6144
HPDC_CPUS_WORKER=1.0
HPDC_MEMORY_WORKER=4096

# Per-node disk capacities (k8s quantity units — use Gi, not GiB)
# kind/docker: used as local-path defaultVolumeSize
# qemu: synthesize virtio data disks (explicit HPDC_DISKS wins for qemu if set)
HPDC_DISK_CAPACITY_WORKER=10Gi
HPDC_DISK_CAPACITY_CONTROL_PLANE=10Gi

# Cluster network + persistent disks
# Disks: first entry = OS disk on ALL nodes, later entries = worker-only data disks
HPDC_SUBNET=10.6.0.0/24
HPDC_DISKS=virtio:10GiB,virtio:10GiB

# Local registry mirror — ALL offline image pulls go here. Nodes pull
# via 10.6.0.1:5000 (Talos mirror patch with skipFallback:true); host-side
# tooling/probes use localhost:5000. Referenced by scripts/services/* and
# scripts/gitops/install_rook_ceph_staging.py (single source of truth — no more
# hard-coded http://localhost:5000 in those scripts).
HPDC_LOCAL_REGISTRY_URL=http://localhost:5000

# Edge gateway IP and Cilium L2 LB pool are derived from HPDC_SUBNET.
#   LB pool = /28 at end of subnet range (e.g. 10.6.0.0/24 → 10.6.0.240/28)
#   Gateway IP = first usable address in pool (e.g. 10.6.0.241)
# /etc/hosts must map *.hpdc.local to the gateway IP.
# Override with HPDC_GATEWAY_IP=<ip> if the derived value doesn't work.

# Dev-only telemetry simulator API key (set by startup).
HPDC_TELEMETRY_API_KEY=dev-telemetry-key-0xDEADBEEF

HPDC_STORAGE_BACKEND=local-path

# Storage staging gate: rook-ceph is reserved for a future staging cluster.
# Set HPDC_STAGING_ENABLED=true (and HPDC_STORAGE_BACKEND=rook-ceph) to enable
# the rook-ceph install step (05-install-rook-ceph-staging). Dev always uses
# local-path and never runs rook-ceph.
HPDC_STAGING_ENABLED=false
