# HPDC Dev Cluster Configuration
# Copy this file to .env and fill in the values

# Gateway IP address (Cilium L2 LoadBalancer pool first IP)
HPDC_GATEWAY_IP=

# Gateway port (HTTP)
HPDC_GATEWAY_PORT=80

# Domain suffix for services
HPDC_DOMAIN=hpdc.local

# Kind cluster name
HPDC_CLUSTER_NAME=hpdc-talos

# Cilium L2 LoadBalancer IP pool range
HPDC_LB_POOL_START=172.18.255.200
HPDC_LB_POOL_STOP=172.18.255.209
