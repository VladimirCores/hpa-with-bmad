# HPDC dev-cluster sizing & topology
# Copy to .env and adjust; bootstrap_talos_dev.py reads these at startup.
# All values are passed straight to `talosctl cluster create qemu`.

# Provisioner backend: qemu (default) or docker (legacy)
HPDC_PROVIDER=qemu

# Node counts / sizing
HPDC_CONTROLPLANES=1
HPDC_WORKERS=3
HPDC_CPUS_CONTROLPLANE=2.0
HPDC_MEMORY_CONTROLPLANE=6144
HPDC_CPUS_WORKER=1.0
HPDC_MEMORY_WORKER=4096

# Cluster network + persistent disks
# Disks: first entry = OS disk on ALL nodes, later entries = worker-only data disks
HPDC_SUBNET=10.6.0.0/24
HPDC_DISKS=virtio:10GiB,virtio:10GiB

# Kubernetes version — MUST match images cached in the local registry mirror
HPDC_KUBERNETES_VERSION=1.35.2
