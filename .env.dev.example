# HPDC dev-cluster environment — DEVELOPMENT defaults
# Copy to .env and adjust; startup.dev.py reads these at startup.
# Component versions are resolved by scripts/gitops/component_versions.py.
# Component toggles (HPDC_*_ENABLED) control which steps run.
#
# Core components (Cilium, Hubble, Rook-Ceph/Local-Path, Harbor, Spegel)
# are always enabled — their toggles are informational only.

# ── Provisioner & sizing ─────────────────────────────────────────────────────
HPDC_PROVIDER=qemu
HPDC_CONTROLPLANES=1
HPDC_WORKERS=3
HPDC_CPUS_CONTROLPLANE=2.0
HPDC_MEMORY_CONTROLPLANE=6144
HPDC_CPUS_WORKER=1.0
HPDC_MEMORY_WORKER=4096

# ── Cluster network + persistent disks ───────────────────────────────────────
HPDC_SUBNET=10.6.0.0/24
HPDC_DISKS=virtio:10GiB,virtio:10GiB

# ── Kubernetes substrate (coupled to Talos; do not bump independently) ────────
HPDC_KUBERNETES_VERSION=1.35.2
HPDC_KUBECTL_VERSION=1.35.2

# ── CNI / mesh ───────────────────────────────────────────────────────────────
HPDC_CILIUM_VERSION=1.20.1
HPDC_CILIUM_ENVOY_TAG=v1.37.5-1786810558-766ccfb37260a43e9d228837aa84ce3faf9f64e7
HPDC_HUBBLE_UI_VERSION=v0.13.5
HPDC_SPIRE_VERSION=1.15.3

# ── Storage ──────────────────────────────────────────────────────────────────
HPDC_ROOK_CEPH_VERSION=1.20.6
HPDC_LOCAL_PATH_PROVISIONER_VERSION=v0.0.37

# ── Registry / offline cache ─────────────────────────────────────────────────
HPDC_HARBOR_VERSION=2.15.2
HPDC_HARBOR_CHART_VERSION=1.19.2
HPDC_HARBOR_REDIS_VERSION=7.4-alpine
HPDC_HARBOR_POSTGRES_VERSION=15.19-alpine
HPDC_SPEGEL_VERSION=0.7.4

# ── GitOps / CD stack ────────────────────────────────────────────────────────
HPDC_ARGOCD_VERSION=3.5.1
HPDC_ARGOCD_REDIS_VERSION=8.2.8-alpine
HPDC_KARGO_VERSION=1.11.2
HPDC_KARGO_CHART_VERSION=1.11.2
HPDC_CERT_MANAGER_CHART_VERSION=v1.21.1
HPDC_CERT_MANAGER_VERSION=1.21.1
HPDC_ARGO_ROLLOUTS_VERSION=1.9.1
HPDC_ROLLOUTS_NGINX_VERSION=1.27-alpine
HPDC_ARGO_EVENTS_VERSION=1.9.11
HPDC_EVENTS_ALPINE_VERSION=3.20

# ── Edge gateway ─────────────────────────────────────────────────────────────
HPDC_ENVOY_GATEWAY_VERSION=1.9.0

# ── Auth / secrets ───────────────────────────────────────────────────────────
HPDC_CASDOOR_VERSION=3.159.0
HPDC_INFISICAL_VERSION=v0.162.24

# ── Observability ────────────────────────────────────────────────────────────
HPDC_GRAFANA_VERSION=13.2.0
HPDC_VICTORIA_METRICS_VERSION=1.150.0
HPDC_VICTORIA_LOGS_VERSION=v1.52.0
HPDC_OTEL_COLLECTOR_VERSION=0.159.0
HPDC_ALERTMANAGER_VERSION=v0.34.0

# ── Developer portal / API docs ──────────────────────────────────────────────
HPDC_BACKSTAGE_VERSION=1.54.0
HPDC_SWAGGER_UI_VERSION=v5.32.14

# ── Utilities ────────────────────────────────────────────────────────────────
HPDC_GIT_MIRROR_IMAGE_VERSION=2.54.0

# ═══════════════════════════════════════════════════════════════════════════════
# Component Toggles (HPDC_*_ENABLED)
#
# Set to true to enable, false to disable.
# Core components are always on — their toggle value is informational only.
# New/unknown components default to false (opt-in).
# ═══════════════════════════════════════════════════════════════════════════════

# ── Storage backend (mutually exclusive: exactly one must be true) ────────────
HPDC_STORAGE_BACKEND=rook-ceph   # choices: rook-ceph | local-path

# ── Core components (always enabled) ─────────────────────────────────────────
HPDC_CILIUM_ENABLED=true         # Cilium CNI — always on
HPDC_HUBBLE_ENABLED=true         # Hubble UI — installed with Cilium
HPDC_ROOK_CEPH_ENABLED=true      # Rook-Ceph storage — always on (mutually exclusive with local-path)
HPDC_LOCAL_PATH_ENABLED=false    # Local-Path Provisioner — mutually exclusive with Rook-Ceph
HPDC_HARBOR_ENABLED=true         # Harbor registry — always on
HPDC_SPEGEL_ENABLED=true         # Spegel P2P distribution — always on

# ── Optional components ──────────────────────────────────────────────────────
HPDC_GIT_MIRROR_ENABLED=true     # Git Mirror
HPDC_KARGO_ENABLED=false         # Kargo warehouse
HPDC_ARGOCD_ENABLED=false        # ArgoCD GitOps
HPDC_ARGO_ROLLOUTS_ENABLED=false # Argo-Rollouts
HPDC_ARGO_EVENTS_ENABLED=false   # Argo-Events
HPDC_ENVOY_GATEWAY_ENABLED=true  # Envoy Gateway
HPDC_CERT_MANAGER_ENABLED=false  # Cert-Manager
HPDC_CASDOOR_ENABLED=true        # Casdoor AuthN
HPDC_CASBIN_ENABLED=true         # Casbin AuthZ
HPDC_INFISICAL_ENABLED=false     # Infisical Secrets
HPDC_BACKSTAGE_ENABLED=false     # Backstage Portal
HPDC_GRAFANA_ENABLED=false       # Grafana Dashboards
HPDC_VICTORIA_METRICS_ENABLED=false  # Victoria Metrics
HPDC_OTEL_ENABLED=false          # OTEL Collector
HPDC_ALERTMANAGER_ENABLED=false  # Alertmanager
HPDC_SWAGGER_UI_ENABLED=false    # Swagger UI / OpenAPI

# ── Sub-system toggles ──────────────────────────────────────────────────────
HPDC_MTLS_ENABLED=false          # Cilium mTLS (sub-system of Cilium)
HPDC_SPIRE_ENABLED=false         # SPIRE identity (sub-system of Cilium)
HPDC_API_KEY_AUTH_ENABLED=false  # API Key Auth (sub-system of Envoy Gateway)
HPDC_CASBIN_RBAC_ENABLED=false   # Casbin RBAC (sub-system of Casbin)
HPDC_CASBIN_REBAC_ENABLED=false  # Casbin ReBAC (sub-system of Casbin)
HPDC_CASBIN_ABAC_ENABLED=false   # Casbin ABAC (sub-system of Casbin)
