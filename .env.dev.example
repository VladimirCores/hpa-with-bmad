# HPDC dev-cluster environment — DEVELOPMENT defaults
# This file references the three-layer config system:
#
#   .env.example              — provisioning & sizing (copy to .env)
#   .env.components.example   — component toggles & storage backend (copy to .env.components)
#   .env.versions.example     — version pins (copy to .env.versions)
#
# Copy the three .example files to your local overrides and customize as needed.
# All layers are loaded together by startup.dev.py / component_versions.load_all_dotenv().
# Existing environment variables always win over file values.
#
# Dev-specific defaults (non-default values for fast local dev):

# ── Provisioner overrides ────────────────────────────────────────────────────
# (uncomment to override .env.example defaults)
# HPDC_PROVIDER=kind
# HPDC_WORKERS=3

# ── Component toggle overrides ───────────────────────────────────────────────
# (uncomment to override .env.components.example defaults)
# HPDC_STORAGE_BACKEND=local-path
# HPDC_ARGOCD_ENABLED=false

# ── Version pin overrides ────────────────────────────────────────────────────
# (uncomment to override .env.versions.example defaults)
# HPDC_KUBERNETES_VERSION=1.35.2
