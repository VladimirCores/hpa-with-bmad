{
  "dashboard": {
    "id": null,
    "uid": "alert-handling",
    "title": "Alert Human Handling",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Alerts Awaiting Acknowledgment",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "sum(alert_state{state='initial'})",
            "legendFormat": "Initial State"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "none"}}
      },
      {
        "id": 2,
        "title": "Open Alerts (Unresolved)",
        "type": "stat",
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "sum(alert_state{state=~'initial|acknowledged|investigating'})",
            "legendFormat": "Open Alerts"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "none"}}
      },
      {
        "id": 3,
        "title": "Audit Actions by Result",
        "type": "timeseries",
        "gridPos": {"x": 8, "y": 0, "w": 16, "h": 8},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "sum(rate(alert_audit_actions_total[5m])) by (result)",
            "legendFormat": "{{result}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Acknowledge Latency (p95)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 4, "w": 4, "h": 4},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "histogram_quantile(0.95, sum(rate(alert_acknowledge_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 5,
        "title": "Resolution Time (Mean)",
        "type": "stat",
        "gridPos": {"x": 4, "y": 4, "w": 4, "h": 4},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "avg(alert_resolution_time_seconds)",
            "legendFormat": "Mean"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 6,
        "title": "Unauthorized Attempts",
        "type": "stat",
        "gridPos": {"x": 8, "y": 8, "w": 8, "h": 4},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "sum(increase(alert_audit_actions_total{result='unauthorized'}[24h]))",
            "legendFormat": "Unauthorized (24h)"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "none"}}
      },
      {
        "id": 7,
        "title": "Invalid Transitions",
        "type": "stat",
        "gridPos": {"x": 16, "y": 8, "w": 8, "h": 4},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "sum(increase(alert_audit_actions_total{result='invalid_transition'}[24h]))",
            "legendFormat": "Invalid (24h)"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "none"}}
      }
    ],
    "time": {"from": "now-24h", "to": "now"}
  }
}
