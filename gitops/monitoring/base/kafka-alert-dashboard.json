{
  "dashboard": {
    "id": null,
    "uid": "kafka-alerts",
    "title": "Kafka Alert Throughput",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Alert Ingestion Rate",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "sum(rate(kafka_consumergroup_consumergroup_lag{topic='alerts.incoming'}[1m]))",
            "legendFormat": "Ingestion Rate"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "id": 2,
        "title": "Critical Alerts",
        "type": "stat",
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "sum(kafka_topic_partition_current_offset{topic='alerts.critical'})",
            "legendFormat": "Critical Count"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "none"}}
      },
      {
        "id": 3,
        "title": "Alert Processing Latency",
        "type": "timechart",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "histogram_quantile(0.95, sum(rate(kafka_message_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "95th Percentile Latency"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "seconds"}}
      },
      {
        "id": 4,
        "title": "DLQ Messages",
        "type": "stat",
        "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "datasource": {"type": "prometheus"},
            "expr": "sum(kafka_topic_partition_current_offset{topic='alerts.dlq'})",
            "legendFormat": "DLQ Count"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 1, "color": "orange"}, {"value": 10, "color": "red"}]}}}
      }
    ],
    "templating": {
      "list": [
        {
          "name": "namespace",
          "type": "query",
          "datasource": {"type": "prometheus"},
          "definition": "label_values(kafka_topic_partition_current_offset, namespace)",
          "refresh": 1
        }
      ]
    }
  }
}