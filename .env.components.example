# HPDC component toggles and feature flags
# Copy to .env.components and adjust; startup.dev.py reads these at startup.
#
# Storage backend selection (rook-ceph or local-path)
#   rook-ceph  = Rook-Ceph distributed storage (production-grade, needs >=3 nodes)
#   local-path = local-path provisioner (single-node fast dev)
HPDC_STORAGE_BACKEND=local-path

# ═══════════════════════════════════════════════════════════════════════════════
# Component Toggles (HPDC_*_ENABLED)
#
# Set to true to enable, false to disable.
# Core components are always on — their toggle value is informational only.
# New/unknown components default to false (opt-in).
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core components (always enabled) ─────────────────────────────────────────
HPDC_CILIUM_ENABLED=true         # Cilium CNI — always on
HPDC_HUBBLE_ENABLED=true         # Hubble UI — installed with Cilium
HPDC_HARBOR_ENABLED=true         # Harbor registry — always on
HPDC_SPEGEL_ENABLED=true         # Spegel P2P distribution — always on

# ── Optional components ──────────────────────────────────────────────────────
HPDC_GIT_MIRROR_ENABLED=true     # Git Mirror
HPDC_KARGO_ENABLED=false         # Kargo warehouse
HPDC_ARGOCD_ENABLED=false        # ArgoCD GitOps
HPDC_ARGO_ROLLOUTS_ENABLED=false # Argo-Rollouts
HPDC_ARGO_EVENTS_ENABLED=false   # Argo-Events
HPDC_ENVOY_GATEWAY_ENABLED=true  # Envoy Gateway
HPDC_CERT_MANAGER_ENABLED=false  # Cert-Manager
HPDC_CASDOOR_ENABLED=true        # Casdoor AuthN
HPDC_CASBIN_ENABLED=true         # Casbin AuthZ
HPDC_PULSAR_ENABLED=true         # Pulsar messaging
HPDC_INFISICAL_ENABLED=false     # Infisical Secrets
HPDC_BACKSTAGE_ENABLED=false     # Backstage Portal
HPDC_GRAFANA_ENABLED=false       # Grafana Dashboards
HPDC_VICTORIA_METRICS_ENABLED=false  # Victoria Metrics
HPDC_OTEL_ENABLED=false          # OTEL Collector
HPDC_ALERTMANAGER_ENABLED=false  # Alertmanager
HPDC_SWAGGER_UI_ENABLED=false    # Swagger UI / OpenAPI

# ── Sub-system toggles ──────────────────────────────────────────────────────
HPDC_MTLS_ENABLED=false          # Cilium mTLS (sub-system of Cilium)
HPDC_SPIRE_ENABLED=false         # SPIRE identity (sub-system of Cilium)
HPDC_API_KEY_AUTH_ENABLED=false  # API Key Auth (sub-system of Envoy Gateway)
HPDC_CASBIN_RBAC_ENABLED=false   # Casbin RBAC (sub-system of Casbin)
HPDC_CASBIN_REBAC_ENABLED=false  # Casbin ReBAC (sub-system of Casbin)
HPDC_CASBIN_ABAC_ENABLED=false   # Casbin ABAC (sub-system of Casbin)
